# Supabase project URL and publishable/anon key are intended for client configuration.
# RLS must remain enabled; never place a service-role key or database password here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Exact origins allowed to call the Supabase Edge Function, comma-separated.
# https://localhost is the Android Capacitor origin for the current app config.
JUNIPER_ALLOWED_ORIGINS=http://localhost:4173,https://localhost
